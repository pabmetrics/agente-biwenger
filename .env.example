# Copia este fichero a .env (ignorado por git) y rellénalo.

# Token Bearer de Biwenger. Cómo sacarlo: en biwenger.as.com, con la sesión
# iniciada, F12 -> Red -> cualquier petición a /api/v2/ -> cabecera
# "Authorization: Bearer <token>". Copia solo lo que va después de "Bearer ".
# Clic derecho -> "Copiar valor" para no cortarlo: son ~125 caracteres con dos
# puntos, y la última parte puede llevar guiones.
BIWENGER_TOKEN=

# Salen de la respuesta de /account (data/bronze/raw_cuenta/...) tras la
# primera ingesta con token; también se ven en las cabeceras X-League y X-User.
BIWENGER_LEAGUE_ID=
BIWENGER_USER_ID=

# Bot de Telegram (avisos y, en la Fase 5, confirmaciones). El token lo da
# @BotFather; el chat_id sale escribiendo al bot (ver docs/puesta-en-marcha.md).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# API de Claude (Fase 4). console.anthropic.com -> API Keys.
ANTHROPIC_API_KEY=

# Opcional: dónde se escriben bronze y silver. En Databricks, Volumes de Unity Catalog.
# BRONZE_PATH=data/bronze
# SILVER_PATH=data/silver
